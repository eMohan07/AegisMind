# ==============================================================================
# AegisMind Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# General settings
AEGISMIND_ENV=development
AEGISMIND_LOG_LEVEL=INFO
AEGISMIND_API_PORT=8000
AEGISMIND_API_HOST=0.0.0.0

# Zanzibar / SpiceDB authorization service
SPICEDB_ENDPOINT=localhost:50051
SPICEDB_PRESHARED_KEY=aegismind_dev_preshared_key
SPICEDB_USE_SSL=false

# Vector storage (PGVector / PostgreSQL)
PGVECTOR_URL=postgresql+psycopg://aegismind:aegismind_secret@localhost:5432/aegismind_vectors
PGVECTOR_COLLECTION_NAME=aegismind_knowledge

# Embedder service (Text Embeddings Inference / TEI or compatible)
TEI_EMBEDDER_URL=http://localhost:8080
TEI_EMBEDDER_MODEL=BAAI/bge-large-en-v1.5
TEI_EMBEDDER_DIMENSION=1024

# Reranker service (TEI Reranker / Cohere / Cross-Encoder)
TEI_RERANKER_URL=http://localhost:8081
TEI_RERANKER_MODEL=BAAI/bge-reranker-large

# Candidate overfetching controls
RETRIEVAL_OVERFETCH_MIN_FACTOR=3.0
RETRIEVAL_OVERFETCH_MAX_FACTOR=5.0
RETRIEVAL_DEFAULT_OVERFETCH_FACTOR=4.0
RETRIEVAL_DEFAULT_TOP_K=5
